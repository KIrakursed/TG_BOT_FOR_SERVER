BOT_TOKEN=
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@localhost:5432/kv_bot
LOG_LEVEL=INFO
ADMIN_IDS=
SEARCH_MODE=FULL_LISTING_MODE
LISTING_PROVIDER=krisha
LLM_PROVIDER=rule
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
SEARCH_MAX_RESULTS=20
KRISHA_MAX_CONCURRENCY=4
KRISHA_MAX_PAGES=5
KRISHA_MAX_CANDIDATES=100
KRISHA_MAX_DETAILS=40
CACHE_TTL_SECONDS=600
USER_SEARCH_RATE_LIMIT_SECONDS=10
USER_ANALYZE_RATE_LIMIT_SECONDS=10
MONITOR_ENABLED=true
MONITOR_INTERVAL_SECONDS=600
MONITOR_MAX_SEARCHES_PER_RUN=20
MONITOR_MAX_RESULTS_PER_SEARCH=100
MONITOR_MAX_NOTIFICATIONS_PER_SEARCH=10
MONITOR_CONCURRENCY=3
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
KRISHA_API_BASE_URL=
KRISHA_API_TOKEN=
KRISHA_SEARCH_PATH=/listings/search
KRISHA_DETAIL_PATH=/listings/{id}
KRISHA_ITEM_URL_TEMPLATE=https://krisha.kz/a/show/{id}
KRISHA_TIMEOUT_SECONDS=15
KRISHA_PER_PAGE=20
KRISHA_HTML_DELAY_SECONDS=2
KRISHA_HTML_DETAIL_DELAY_SECONDS=1
KRISHA_HTML_TIMEOUT_SECONDS=20
KRISHA_HTML_HAS_PHOTO=True
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_ENABLED=false
FIRECRAWL_CACHE_TTL_SECONDS=3600
FIRECRAWL_MAX_CONCURRENCY=2

# --- Egress relay -------------------------------------------------------------
# Krisha/Kolesa silently drop TCP from datacenter ranges (Oracle Cloud, etc.), so
# every direct request dies with a 20 s timeout and search returns nothing.
# Set a relay that fetches the page from its own IP and returns raw HTML:
#   KRISHA_FETCH_RELAY=https://r.jina.ai/
# Free relays allow ~20 req/min per IP, hence the pacing below.
KRISHA_FETCH_RELAY=
KRISHA_RELAY_TOKEN=
KRISHA_RELAY_TIMEOUT_SECONDS=45
KRISHA_RELAY_MIN_INTERVAL_SECONDS=3.2
# --- Release hardening --------------------------------------------------------
# Hosts allowed in the "open listing" button. Anything else is dropped: a tampered
# card from a third-party relay must not become a phishing link in a trusted message.
LISTING_ALLOWED_HOSTS=krisha.kz
